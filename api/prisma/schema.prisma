generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  posts        Post[]
}

model Post {
  id       Int       @id @default(autoincrement())
  title    String
  content  String
  authorId Int
  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]
}

model Comment {
  id         Int    @id @default(autoincrement())
  authorName String
  content    String
  postId     Int
  post       Post   @relation(fields: [postId], references: [id])
}
